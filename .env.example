PUBSUB_PROJECT_ID=your-gcp-project-id
PUBSUB_EMULATOR_HOST=localhost:8085

# Utenti: JSON array di {username, password}
AUTH_USERS=[{"username":"admin","password":"changeme"}]

# Secret per iron-session — minimo 32 caratteri casuali
SESSION_SECRET=change-this-to-a-random-32-char-string!!

# Messaggi tenuti in memoria dallo store
MAX_MESSAGES=500

# Intervallo di polling della UI (ms)
NEXT_PUBLIC_POLL_INTERVAL_MS=1000

# Viewer legacy standalone (node server.js)
LEGACY_VIEWER_PORT=3080
LEGACY_VIEWER_MAX_MESSAGES=100
